#include <stdio.h>
#include <stdlib.h>

// Helper function to swap two integers
void swap(int* a, int* b) {
    int temp = *a;
    *a = *b;
    *b = temp;
}

// ==========================================
// 1. MAX-HEAPIFY & MIN-HEAPIFY OPERATIONS
// ==========================================

// Maintains the Max-Heap property for a subtree rooted at index i
void maxHeapify(int arr[], int n, int i) {
    int largest = i;       // Initialize largest as root
    int left = 2 * i + 1;  // left child index
    int right = 2 * i + 2; // right child index

    // If left child is larger than root
    if (left < n && arr[left] > arr[largest])
        largest = left;

    // If right child is larger than largest so far
    if (right < n && arr[right] > arr[largest])
        largest = right;

    // If largest is not root, swap and continue heapifying down
    if (largest != i) {
        swap(&arr[i], &arr[largest]);
        maxHeapify(arr, n, largest);
    }
}

// Maintains the Min-Heap property for a subtree rooted at index i
void minHeapify(int arr[], int n, int i) {
    int smallest = i;      // Initialize smallest as root
    int left = 2 * i + 1;  // left child index
    int right = 2 * i + 2; // right child index

    // If left child is smaller than root
    if (left < n && arr[left] < arr[smallest])
        smallest = left;

    // If right child is smaller than smallest so far
    if (right < n && arr[right] < arr[smallest])
        smallest = right;

    // If smallest is not root, swap and continue heapifying down
    if (smallest != i) {
        swap(&arr[i], &arr[smallest]);
        minHeapify(arr, n, smallest);
    }
}

// ==========================================
// 2. HEAP SORT (Sorts in ascending order)
// ==========================================
void heapSort(int arr[], int n) {
    // Step 1: Build a Max-Heap from the raw array
    // Start from the last non-leaf node and move upwards
    for (int i = n / 2 - 1; i >= 0; i--) {
        maxHeapify(arr, n, i);
    }

    // Step 2: One by one extract elements from the heap
    for (int i = n - 1; i > 0; i--) {
        // Move current root (maximum element) to the end of the array
        swap(&arr[0], &arr[i]);

        // Call maxHeapify on the reduced heap to restore order at root
        maxHeapify(arr, i, 0);
    }
}

// ==========================================
// UTILITY FUNCTIONS
// ==========================================
void printArray(int arr[], int n) {
    for (int i = 0; i < n; i++) {
        printf("%d ", arr[i]);
    }
    printf("\n");
}

int main() {
    int arr[] = {12, 11, 13, 5, 6, 7};
    int n = sizeof(arr) / sizeof(arr[0]);

    printf("Original array:\n");
    printArray(arr, n);

    // Demonstration of converting an array to a Min-Heap
    int minHeapArr[] = {12, 11, 13, 5, 6, 7};
    for (int i = n / 2 - 1; i >= 0; i--) {
        minHeapify(minHeapArr, n, i);
    }
    printf("\nArray converted to Min-Heap (Root is smallest):\n");
    printArray(minHeapArr, n);

    // Demonstration of Heap Sort (uses Max-Heap internally)
    heapSort(arr, n);
    printf("\nArray sorted via Heap Sort (Ascending Order):\n");
    printArray(arr, n);

    return 0;
}
